# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private dashboard access
DASHBOARD_PASSWORD=
AUTH_SECRET=

# Optional fallback Vercel Cron request verification
CRON_SECRET=

# Supabase Data REST API (server-side only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback if your project still uses service-role keys:
SUPABASE_SERVICE_ROLE_KEY=

# AI provider. Gemini is the default/free path; set to openai only when you explicitly want OpenAI API usage.
AI_PROVIDER=gemini

# Gemini Interactions API
GEMINI_API_KEY=
GEMINI_MODEL_JOB_ANALYSIS=gemini-3.6-flash
GEMINI_MODEL_APPLICATION_PACK=gemini-3.6-flash

# Optional paid OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL_JOB_ANALYSIS=gpt-5.6-luna
OPENAI_MODEL_APPLICATION_PACK=gpt-5.6-terra
OPENAI_MODEL_RESEARCH=gpt-5.6-terra

# Gmail OAuth. Daily digest is skipped when these are absent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_DIGEST_TO=

# Optional ATS sources as comma-separated board/site slugs.
GREENHOUSE_BOARDS=
LEVER_SITES=
ASHBY_BOARDS=

# Discovery tuning
DISCOVERY_MAX_AGE_DAYS=14
MAX_ANALYSES_PER_RUN=12
ANALYSIS_CONCURRENCY=3

# Optional private first-boot profile JSON. Prefer saving through Settings once Supabase is configured.
CANDIDATE_PROFILE_JSON=
